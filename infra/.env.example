# =============================================================================
# UNNATI — Environment Variables
# =============================================================================
# Copy to .env and fill in real values. Never commit .env files.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unnati?schema=public

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── MinIO (S3-compatible) ────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=unnati-uploads
MINIO_USE_SSL=false

# ── Keycloak (OIDC) ─────────────────────────────────────────────────────────
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/unnati
KEYCLOAK_CLIENT_ID=unnati-core
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://localhost:5173/auth/callback

# ── Core API ─────────────────────────────────────────────────────────────────
CORE_API_PORT=3000
CORE_API_HOST=0.0.0.0

# ── AI Service ───────────────────────────────────────────────────────────────
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0

# ── LLM Gateway ──────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama          # ollama | anthropic | openai | vllm
LLM_MODEL=qwen2.5:7b         # model name for the chosen provider
LLM_API_KEY=                 # required for anthropic/openai
LLM_BASE_URL=http://localhost:11434  # ollama default
MAX_TOKENS_PER_CALL=4096
MAX_CALLS_PER_MINUTE=30

# ── Bhashini (Translation/Voice) ─────────────────────────────────────────────
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=unnati
VITE_KEYCLOAK_CLIENT_ID=unnati-web

# ── Docker ───────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres
KEYCLOAK_ADMIN_PASSWORD=admin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
